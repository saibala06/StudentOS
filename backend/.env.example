# StudentOS Backend Environment Config
# Copy this file to .env and adjust values as needed.

# Secret used to sign JWT auth tokens. Change this in any real deployment.
SECRET_KEY=studentos-dev-secret-change-me

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database location (SQLite file, relative to backend/ directory)
DATABASE_URL=sqlite:///./studentos.db

# --- Optional AI integration (NOT required to run the app) ---
# The core scheduling/personalization engine is fully deterministic and
# works with none of these set. These only enable the optional
# natural-language layer of the AI Assistant (nicer phrasing / parsing of
# free-text "something came up" messages). Leave blank to use the built-in
# local rule-based assistant.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=local
