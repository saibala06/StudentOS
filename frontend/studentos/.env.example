# StudentOS frontend has no .env file — Flutter reads config at build/run
# time via --dart-define instead. This file documents the one variable
# that matters.
#
# STUDENTOS_API_BASE_URL
#   Overrides the backend base URL the app talks to. If unset, the app
#   auto-selects a sane default:
#     - Android emulator -> http://10.0.2.2:8000
#     - iOS simulator / desktop / web -> http://localhost:8000
#
#   Set this explicitly when running on a PHYSICAL device, using your
#   computer's LAN IP, e.g.:
#
#   flutter run --dart-define=STUDENTOS_API_BASE_URL=http://192.168.1.23:8000
